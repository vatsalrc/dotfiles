# zsh config switchers
use_ohmyzsh() {
    cp ~/.zshrc.ohmyzsh ~/.zshrc
    exec zsh
}

use_default() {
    cp ~/.zshrc.pre-oh-my-zsh ~/.zshrc
    exec zsh
}

# loader function
ss() {
    local mode="$1"

    case "$mode" in
        ohmyzsh)
            source "$HOME/.zshrc.ohmyzsh"
            echo "Switched to Oh My Zsh"
            ;;
        default)
            source "$HOME/.zshrc.pre-oh-my-zsh"
            echo "Switched to default zsh"
            ;;
        *)
            echo "Usage: switch_zsh [ohmyzsh|default]"
            ;;
    esac
}
# Dissertation helper
diss() {
  local folder="$HOME/uni/dissertation"

  case "$1" in
    inter)
      open "$HOME/uni/dissertation/vrc4/vrc4_interim_report..pdf"
      ;;
    prel)
      open "$HOME/uni/dissertation/vrc4/preliminary-report/vrc4_preliminary_report.pdf"
      ;;
    info)
      open "$HOME/uni/dissertation/info/study-guide.pdf"
      ;;
    des)
      open "$HOME/uni/dissertation/select/got/GECCO 2024 Space Optimisation Competition (SPoC).pdf"
      ;;
    open)
      open "$HOME/uni/dissertation"
      ;;
    web)
      open "https://campus.cs.le.ac.uk/gitlab/pgt_project/25_26_spring/vrc4"
      ;;
    code)
      nvim "$folder/vrc4"
      ;;
    pull)
      cd "$folder/vrc4" && git pull
      ;;
    help|--help|-h)
      echo "Usage: diss [command]"
      echo "Commands:"
      echo "  main  - go to main working directory"
      echo "  web   - open GitLab project page"
      echo "  code  - open project in fresh text editor"
      echo "  pull  - git pull in folder"
      echo "  help  - show this message"
      echo "  des   - open the description of the dissertation"
      echo "  info  - open study guide"
      echo "  prel  - open preliminary report"
      echo "  inter - open interim report"
      ;;
    "")
      cd "$folder/vrc4"
      ;;
    *)
      echo "Unknown command: $1"
      echo "Try 'diss help'"
      ;;
  esac
}

