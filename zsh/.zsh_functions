# Open a specific Apple Note
note() {
    local note_title="$1"

    if [[ -z "$note_title" ]]; then
        echo "Usage: note <note title>"
        return 1
    fi

    osascript <<EOF
tell application "Notes"
    set foundNotes to notes whose name is "$note_title"
    if (count of foundNotes) > 0 then
        show first item of foundNotes
    else
        display alert "Note not found: $note_title"
    end if
end tell
EOF
}

# sauce
sauce() {
    local folder="$HOME/sauce"

    case "$1" in
        "")
            cd "$folder" || { echo "Folder not found: $folder"; return 1; }
            ;;
        open)
            open "$folder"
            ;;
        *)
            echo "Unknown command: $1"
            ;;
    esac
}

# yt-dlp helper
phdl() {
  yt-dlp \
    --cookies-from-browser chrome \
    -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]" \
    --merge-output-format mp4 \
    -o "$HOME/Downloads/%(title)s.%(ext)s" \
    "$1"
}

# ffmpeg enhance helper
enhance() {
  ffmpeg -i "$1" \
    -vf "hqdn3d=1.5:1.5:6:6,eq=contrast=1.08:brightness=0.01:saturation=1.07,unsharp=7:7:0.7" \
    -c:v h264_videotoolbox \
    -b:v 10M \
    -c:a copy "${2:-output_topgear_style.mp4}"
}

