#imsg shortcut
snd() {
    first="$1"
    message="$2"

    if [ -z "$first" ]; then
        echo "name not provided"
        return 1
    elif [ -z "$message" ]; then
        echo "message not provided"
        return 1
    fi

    matches=$(osascript <<EOF
tell application "Contacts"
    set matches to (every person whose first name is "$first")
    set output to ""
    repeat with p in matches
        set output to output & (first name of p) & " " & (last name of p) & "\n"
    end repeat
    return output
end tell
EOF
)
    echo "match found: $matches" 
    if [ -z "$matches" ]; then
        echo "no contact found for '$first'"
        return 1
    fi

    # count number of matches
    count=$(echo "$matches" | grep -c .)

    if [ "$count" -eq 1 ]; then
        name="$matches"
    else
        echo "multiple matches found:"
        i=1
        while IFS= read -r line; do
            echo "$i) $line"
            i=$((i+1))
        done <<< "$matches"

        read "choice?pick a number: "
        name=$(echo "$matches" | sed -n "${choice}p")
    fi

    command imsg send --to "$name" --text "$message"
}

