alias zshconfig="nvim ~/.zshrc"
alias todo="glow $HOME/Documents/todo.md"
alias tg="open 'https://www.bbc.co.uk/iplayer/episode/b00tbs3z/top-gear-series-15-episode-6?seriesId=b006mj59-structural-15-b00sym5n'"
alias pip="pip3"
alias python="python3"
alias updatebrew="brew update && brew upgrade && brew cleanup"
alias bk="cd .."
alias smqa="cd modules/smqa"
alias or="cd modules/or"
alias keyman="open $HOME/Documents/manuals/keyboard/AULA_F75_manual_compressed.pdf"
alias cls="clear"
alias uni="cd $HOME/uni"
alias reload="source ~/.zshrc"
alias mod-initlua="nvim $HOME/.config/nvim/init.lua"
alias cuslang="cd $HOME/uni/modules/sem\ 2/smqa/smqa-coursework"
alias resume="cd $HOME/Documents/Resume"
alias n="nvim"
alias clilist="glow ~/cli-tools/list.md"
alias wp="nchat"
alias nchat='TERM=xterm-256color nchat'
alias twp="tmux a -t wp"
alias bu="brew up"
alias bug="brew upgrade"
alias bc="brew cleanup"
